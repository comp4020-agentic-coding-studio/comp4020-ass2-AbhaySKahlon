---
/**
 * The identity metadata strip for the course-banner system. The banner's
 * artwork and title are rendered separately by the theme's own unmodified
 * Hero component — each page passes a `heroImage` (one of the placeholder
 * SVGs generated by scripts/gen-banner-placeholders.mjs, or later, the
 * course's real supplied artwork) plus its own `title` straight to
 * ContentLayout/BaseLayout. CourseBanner renders only the eyebrow/week/
 * mechanism/date context line that sits directly beneath that hero, and (via
 * the global styles below) sizes the hero itself so the whole system reads
 * as one deliberate banner rather than the theme's default hero treatment.
 *
 * `title` isn't shown here (Hero already shows it) — it names the region for
 * assistive tech.
 */
import { formatCourseDate } from "../lib/dates";

interface Props {
  title: string;
  eyebrow?: string;
  weekNumber?: number;
  mechanism?: string;
  date?: Date;
}

const { title, eyebrow, weekNumber, mechanism, date } = Astro.props;
const hasMeta = weekNumber !== undefined || mechanism !== undefined || date !== undefined;
---

{
  (eyebrow || hasMeta) && (
    <div class="course-banner" aria-label={`${title} overview`}>
      {eyebrow && <p class="course-banner-eyebrow">{eyebrow}</p>}
      {hasMeta && (
        <p class="course-banner-meta">
          {[
            weekNumber !== undefined ? `Week ${weekNumber} of 12` : null,
            mechanism,
            date ? formatCourseDate(date) : null,
          ]
            .filter((part): part is string => Boolean(part))
            .map((part, i) => (
              <>
                {i > 0 && " · "}
                <span class:list={[{ "course-banner-mechanism": part === mechanism }]}>{part}</span>
              </>
            ))}
        </p>
      )}
    </div>
  )
}

<style>
  .course-banner {
    margin-block: 0 1.5rem;
  }

  .course-banner-eyebrow {
    margin: 0 0 0.5rem;
    font-size: var(--at-font-size-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .course-banner-meta {
    margin: 0;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
    font-weight: 600;
  }

  .course-banner-mechanism {
    color: var(--at-heading);
  }
</style>

<style is:global>
  /* Hero sizing for the course-banner system. The banner is a compact header
     — nav, then a short identity strip, then the page content — not a
     full-height splash, so this fixes an actual pixel-height target rather
     than just pinning the box to the artwork's own aspect ratio. Desktop
     targets ~300px at a 1920px-wide viewport (32:5 = 1920/300, matching the
     banner artwork's own 1600x250 canvas exactly, so `object-fit: cover` has
     nothing to crop at that width); the `min-height`/`max-height` pair keeps
     it in the ~220-340px band at other desktop widths. Below 640px the
     target is ~150-180px tall at a 390px-wide phone (26:11 = 390/165), a
     visibly squarer box than the wide desktop one — `cover` crops the
     artwork's left/right edges there, never its top/bottom, which is what
     the artwork's own horizontal safe-zone comment accounts for. Unlayered
     so it wins over the theme's own @layer at.components without editing
     theme files; every page in this course that sets heroImage is part of
     the banner system, so a global rule is correct here rather than a risk. */
  .at-hero {
    aspect-ratio: 32 / 5;
    min-height: 220px;
    max-height: 340px;
  }

  .at-hero-title {
    padding-block: var(--at-spacing-md) var(--at-spacing-lg);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }

  .at-hero-title::after {
    margin-block-start: var(--at-spacing-sm);
  }

  @media (width < 640px) {
    .at-hero {
      aspect-ratio: 26 / 11;
      min-height: 150px;
      max-height: 180px;
    }

    .at-hero-title {
      padding-block: var(--at-spacing-sm) var(--at-spacing-md);
      font-size: clamp(1.25rem, 6vw, 1.75rem);
    }

    .at-hero-title::after {
      margin-block-start: var(--at-spacing-xs);
    }
  }
</style>

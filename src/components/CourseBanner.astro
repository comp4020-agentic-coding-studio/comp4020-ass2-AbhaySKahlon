---
/**
 * The identity metadata strip for the course-banner system. The banner's
 * artwork and title are rendered separately by the theme's own unmodified
 * Hero component — each page passes a `heroImage` (one of the placeholder
 * SVGs generated by scripts/gen-banner-placeholders.mjs, or later, the
 * course's real supplied artwork) plus its own `title` straight to
 * ContentLayout/BaseLayout. CourseBanner renders only the eyebrow/week/
 * mechanism/date context line that sits directly beneath that hero, and (via
 * the global styles below) sizes the hero itself so the whole system reads
 * as one deliberate banner rather than the theme's default hero treatment.
 *
 * `title` isn't shown here (Hero already shows it) — it names the region for
 * assistive tech.
 */
import { formatCourseDate } from "../lib/dates";

interface Props {
  title: string;
  eyebrow?: string;
  weekNumber?: number;
  mechanism?: string;
  date?: Date;
}

const { title, eyebrow, weekNumber, mechanism, date } = Astro.props;
const hasMeta = weekNumber !== undefined || mechanism !== undefined || date !== undefined;
---

{
  (eyebrow || hasMeta) && (
    <div class="course-banner" aria-label={`${title} overview`}>
      {eyebrow && <p class="course-banner-eyebrow">{eyebrow}</p>}
      {hasMeta && (
        <p class="course-banner-meta">
          {[
            weekNumber !== undefined ? `Week ${weekNumber} of 12` : null,
            mechanism,
            date ? formatCourseDate(date) : null,
          ]
            .filter((part): part is string => Boolean(part))
            .map((part, i) => (
              <>
                {i > 0 && " · "}
                <span class:list={[{ "course-banner-mechanism": part === mechanism }]}>{part}</span>
              </>
            ))}
        </p>
      )}
    </div>
  )
}

<style>
  .course-banner {
    margin-block: 0 1.5rem;
  }

  .course-banner-eyebrow {
    margin: 0 0 0.5rem;
    font-size: var(--at-font-size-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .course-banner-meta {
    margin: 0;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
    font-weight: 600;
  }

  .course-banner-mechanism {
    color: var(--at-heading);
  }
</style>

<style is:global>
  /* Hero sizing for the course-banner system: a large horizontal editorial
     banner at desktop widths, substantially shorter — not simply scaled
     down — below the theme's single 640px breakpoint. Unlayered so it wins
     over the theme's own @layer at.components without editing theme files;
     every page in this course that sets heroImage is part of the banner
     system, so a global rule is correct here rather than a risk. */
  .at-hero {
    min-height: 22rem;
  }

  @media (width < 640px) {
    .at-hero {
      min-height: 11rem;
    }

    .at-hero-title {
      padding-block: var(--at-spacing-lg);
      font-size: clamp(1.5rem, 8vw, 2.25rem);
    }

    .at-hero-title::after {
      margin-block-start: var(--at-spacing-sm);
    }
  }
</style>

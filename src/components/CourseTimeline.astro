---
/**
 * The homepage's 12-week queue-line timeline: one real link per week (its
 * accessible name is its own text content, "Week N <title>", so nothing here
 * depends on a tooltip or on hover), plus a marker on any week an assessment
 * is due. Horizontal queue-line at desktop; a stacked list at mobile — a
 * genuine layout change, not the same row scaled down.
 */
import type { CollectionEntry } from "astro:content";
import { withBase } from "astro-theme-university/url";
import { phaseForWeek } from "../lib/phases";

interface Props {
  lectures: CollectionEntry<"lectures">[];
  assessments: CollectionEntry<"assessments">[];
}

const { lectures, assessments } = Astro.props;
const sorted = [...lectures].sort((a, b) => a.data.week - b.data.week);
const dueByWeek = new Map(assessments.map((a) => [a.data.week, a]));
---

<ol class="course-timeline" aria-label="Twelve-week course timeline">
  {
    sorted.map((lecture) => {
      const due = dueByWeek.get(lecture.data.week);
      const phase = phaseForWeek(lecture.data.week);
      return (
        <li class="course-timeline-item" data-phase={phase}>
          <a href={withBase(`/lectures/${lecture.id}/`)} class="course-timeline-link">
            <span class="course-timeline-week">Week {lecture.data.week}</span>
            <span class="course-timeline-title">{lecture.data.title}</span>
            <span class="course-timeline-phase">{phase}</span>
          </a>
          {due && <span class="course-timeline-due">{due.data.title} due</span>}
        </li>
      );
    })
  }
</ol>

<style>
  .course-timeline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0.75rem 0 0;
    list-style: none;
    border-top: 3px solid var(--at-bg-alt);
  }

  .course-timeline-item {
    position: relative;
    flex: 1 1 7rem;
  }

  .course-timeline-link {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: 0.4rem;
    text-decoration: none;
    color: inherit;
  }

  .course-timeline-link:hover {
    background: var(--at-bg-alt);
  }

  .course-timeline-week {
    display: block;
    font-size: var(--at-font-size-sm);
    font-weight: 700;
    color: var(--at-primary);
  }

  .course-timeline-title {
    display: block;
    font-weight: 600;
  }

  .course-timeline-phase {
    display: block;
    margin-block-start: 0.15rem;
    font-size: var(--at-font-size-sm);
    color: var(--at-text-secondary);
  }

  .course-timeline-due {
    display: block;
    margin-block-start: 0.25rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--at-primary) 18%, var(--at-bg-alt));
    color: var(--at-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
  }

  @media (width < 640px) {
    .course-timeline {
      flex-direction: column;
      border-top: none;
    }

    .course-timeline-item {
      border-inline-start: 3px solid var(--at-bg-alt);
    }

    .course-timeline-link {
      padding-inline-start: 0.75rem;
    }
  }
</style>
